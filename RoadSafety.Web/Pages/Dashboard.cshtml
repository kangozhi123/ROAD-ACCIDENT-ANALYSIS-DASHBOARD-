@page
@model RoadSafety.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="panel">
    <h1 class="panel__title">Welcome, @Model.OfficerName</h1>

    <dl class="detail-list">
        <dt>Force number</dt>
        <dd>@Model.ForceNumber</dd>

        <dt>Station</dt>
        <dd>@Model.BranchName</dd>

        <dt>Organisation</dt>
        <dd>@Model.CompanyName</dd>
    </dl>

    <p class="notice">
        Accident data has not been loaded yet. Charts and the hotspot map arrive
        once the collision dataset is imported.
    </p>

    <form method="post" asp-page="/Logout">
        <button type="submit" class="btn-ghost-brand">Sign out</button>
    </form>
</div>

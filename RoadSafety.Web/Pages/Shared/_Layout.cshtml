@{
    var fullName = User.Identity?.Name ?? "Officer";
    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Road Accident Analysis</title>

    @* Bootstrap first, page libraries second, brand last — so site.css wins
       wherever they overlap. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Applied before first paint so a collapsed sidebar never flashes open.
        try {
            if (localStorage.getItem('navCollapsed') === '1' && window.innerWidth > 940) {
                document.documentElement.classList.add('nav-collapsed');
            }
        } catch (e) { }
    </script>
</head>
<body>

<aside class="sidebar" id="sidebar">
    <a class="sidebar__logo" asp-page="/Dashboard">
        <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M24 3 6 10v13c0 11 7.7 19.9 18 22 10.3-2.1 18-11 18-22V10L24 3Z"
                  fill="rgba(255,255,255,.16)" stroke="#fff" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M24 14v20M17 20h14M15 27h18" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <span>Road Accident<br />Analysis</span>
    </a>

    <nav class="sidebar__nav">
        <a class="nav-item @(currentPage == "/Dashboard" ? "is-active" : "")" asp-page="/Dashboard" title="Dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="5" rx="1" />
                <rect x="14" y="12" width="7" height="9" rx="1" /><rect x="3" y="16" width="7" height="5" rx="1" />
            </svg>
            Dashboard
        </a>

        <a class="nav-item @(currentPage == "/Users" ? "is-active" : "")" asp-page="/Users" title="Officers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.9" />
            </svg>
            Officers
        </a>

        @if (User.HasClaim("perm", RoadSafety.Web.Services.Permissions.AssignRoles))
        {
            <a class="nav-item @(currentPage == "/Roles" ? "is-active" : "")" asp-page="/Roles" title="Roles">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3 4 6.5v5c0 5 3.4 8.9 8 10 4.6-1.1 8-5 8-10v-5L12 3Z" /><path d="m9 12 2 2 4-4" />
                </svg>
                Roles
            </a>
        }

        <a class="nav-item @(currentPage == "/Incidents" ? "is-active" : "")" asp-page="/Incidents" title="Incidents">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9v4M12 17h.01" />
                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
            </svg>
            Incidents
        </a>

        <span class="nav-item is-soon" aria-disabled="true" title="Hotspots — not built yet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" />
            </svg>
            Hotspots
            <span class="nav-item__tag">Soon</span>
        </span>

        <span class="nav-item is-soon" aria-disabled="true" title="Severity model — not built yet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12h4l3 8 4-16 3 8h4" />
            </svg>
            Severity model
            <span class="nav-item__tag">Soon</span>
        </span>

        <span class="nav-item is-soon" aria-disabled="true" title="Reports — not built yet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3v5h5" /><path d="M19 8v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h8l5 5Z" />
            </svg>
            Reports
            <span class="nav-item__tag">Soon</span>
        </span>
    </nav>

    <p class="sidebar__foot">
        Signed in as @fullName<br />
        @User.FindFirst("ForceNumber")?.Value
    </p>
</aside>

<div class="nav-scrim" id="navScrim"></div>

<div class="shell__main">
    <header class="topbar">
        <button type="button" class="nav-toggle" id="navToggle"
                aria-controls="sidebar" aria-expanded="true" aria-label="Toggle navigation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
        </button>

        <div class="topbar__greeting">
            @ViewData["Title"]
            <small>@User.FindFirst("BranchName")?.Value · @User.FindFirst("CompanyName")?.Value</small>
        </div>

        <form class="topbar__search" method="get" asp-page="/Dashboard" role="search">
            <label class="visually-hidden" for="topSearch">Search officers and stations</label>
            <input type="search" id="topSearch" name="q" value="@Context.Request.Query["q"]"
                   placeholder="Search officers or stations" autocomplete="off" />
            <button type="submit" aria-label="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                </svg>
            </button>
        </form>

        <div class="topbar__right">
            <div class="dropdown">
                <button class="account" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="avatar" aria-hidden="true">@initials</span>
                    <span class="account__meta">
                        <strong>@fullName</strong>
                        <span>@User.FindFirst("ForceNumber")?.Value</span>
                    </span>
                    <svg class="account__caret" viewBox="0 0 12 8" aria-hidden="true">
                        <path fill="currentColor" d="M1.4 0 6 4.6 10.6 0 12 1.4 6 7.4 0 1.4z" />
                    </svg>
                </button>

                <div class="dropdown-menu dropdown-menu-end account-menu">
                    <div class="account-menu__head">
                        <strong>@fullName</strong>
                        <span>@User.FindFirst("BranchName")?.Value</span>
                        <span>@User.FindFirst("CompanyName")?.Value</span>
                    </div>

                    <form method="post" asp-page="/Logout" id="signOutForm">
                        <button type="submit" class="dropdown-item">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    @* Every page's content sits in the same centred column, so headers,
       tables and cards line up from one screen to the next. *@
    <main class="page">
        @RenderBody()
    </main>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<script src="~/js/notify.js" asp-append-version="true"></script>

@if (TempData["Toast"] is string toast)
{
    <script>notify.success(@Html.Raw(Json.Serialize(toast)));</script>
}

@if (TempData["ToastError"] is string toastError)
{
    <script>notify.failure(@Html.Raw(Json.Serialize(toastError)));</script>
}

<script>
    (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('navToggle');
        var scrim = document.getElementById('navScrim');
        var MOBILE = 940;

        function isMobile() {
            return window.innerWidth <= MOBILE;
        }

        function syncLabel() {
            var shown = isMobile()
                ? root.classList.contains('nav-open')
                : !root.classList.contains('nav-collapsed');
            toggle.setAttribute('aria-expanded', String(shown));
        }

        toggle.addEventListener('click', function () {
            if (isMobile()) {
                // On a drawer the toggle opens and closes; it does not shrink.
                root.classList.toggle('nav-open');
            } else {
                root.classList.toggle('nav-collapsed');
                try {
                    localStorage.setItem(
                        'navCollapsed',
                        root.classList.contains('nav-collapsed') ? '1' : '0');
                } catch (e) { }
            }
            syncLabel();
        });

        scrim.addEventListener('click', function () {
            root.classList.remove('nav-open');
            syncLabel();
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && root.classList.contains('nav-open')) {
                root.classList.remove('nav-open');
                syncLabel();
            }
        });

        // Leaving mobile must not strand the drawer in the open state.
        window.addEventListener('resize', function () {
            if (!isMobile()) {
                root.classList.remove('nav-open');
            }
            syncLabel();
        });

        syncLabel();
    })();

    (function () {
        var form = document.getElementById('signOutForm');
        if (!form) return;

        form.addEventListener('submit', function (event) {
            if (form.dataset.confirmed === 'true') return;

            event.preventDefault();
            notify.confirm({
                title: 'Sign out?',
                text: 'You will need your force number to sign back in.',
                confirmText: 'Sign out'
            }).then(function (confirmed) {
                if (confirmed) {
                    form.dataset.confirmed = 'true';
                    form.submit();
                }
            });
        });
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

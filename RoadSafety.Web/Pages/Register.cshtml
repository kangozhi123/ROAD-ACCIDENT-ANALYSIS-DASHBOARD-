@page
@model RoadSafety.Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <aside class="auth-aside">
        <svg class="auth-aside__mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M24 3 6 10v13c0 11 7.7 19.9 18 22 10.3-2.1 18-11 18-22V10L24 3Z"
                  fill="rgba(255,255,255,.16)" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
            <path d="M24 14v20M17 20h14M15 27h18" stroke="#fff" stroke-width="2" stroke-linecap="round" />
        </svg>

        <h1>Welcome</h1>
        <p>Register your force number to reach accident analysis for your station.</p>

        <a class="auth-aside__action" asp-page="/Index">Sign in</a>
    </aside>

    <section class="auth-main">

        <form method="post" novalidate>
            <div class="auth-main__head">
                <div class="segmented" role="radiogroup" aria-label="Organisation">
                    @foreach (var company in Model.Companies)
                    {
                        <label class="segmented__option">
                            <input type="radio"
                                   asp-for="Input.CompanyId"
                                   value="@company.Id"
                                   data-company-name="@company.Name" />
                            <span>@company.Name</span>
                        </label>
                    }
                </div>
            </div>

            <h2 class="auth-title" id="formTitle">Create your officer account</h2>
            <p class="auth-subtitle">Choose your organisation, then the station you are posted to.</p>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert-brand" role="alert">@Model.ErrorMessage</div>
            }

            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.FullName"></label>
                    <input asp-for="Input.FullName" placeholder="Grace Banda" autocomplete="name" />
                    <span class="field-error" asp-validation-for="Input.FullName"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.ForceNumber"></label>
                    <input asp-for="Input.ForceNumber" placeholder="ZP-00123" autocomplete="username" />
                    <span class="field-error" asp-validation-for="Input.ForceNumber"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" placeholder="grace.banda@police.gov.zm" autocomplete="email" />
                    <span class="field-error" asp-validation-for="Input.Email"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.BranchReferenceNumber"></label>
                    <select asp-for="Input.BranchReferenceNumber" id="branchSelect">
                        <option value="">Choose an organisation first</option>
                    </select>
                    <span class="field-error" asp-validation-for="Input.BranchReferenceNumber"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" placeholder="At least 8 characters" autocomplete="new-password" />
                    <span class="field-error" asp-validation-for="Input.Password"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password" />
                    <span class="field-error" asp-validation-for="Input.ConfirmPassword"></span>
                </div>

                <div class="field field--wide">
                    <span class="field-error" asp-validation-for="Input.CompanyId"></span>
                </div>
            </div>

            <div class="form-actions form-actions--split">
                <a class="link-muted" asp-page="/Index">Already registered? <b>Sign in</b></a>
                <button type="submit" class="btn-primary-brand">Create account</button>
            </div>
        </form>

    </section>
</div>

@section Scripts {
    <script id="branchData" type="application/json">@Html.Raw(Model.BranchesJson)</script>
    <script>
        (function () {
            var branches = JSON.parse(document.getElementById('branchData').textContent);
            var companyInputs = Array.prototype.slice.call(
                document.querySelectorAll('input[name="Input.CompanyId"]'));
            var branchSelect = document.getElementById('branchSelect');
            var formTitle = document.getElementById('formTitle');
            var chosenBranch = '@Model.Input.BranchReferenceNumber';

            function selectedCompany() {
                for (var i = 0; i < companyInputs.length; i++) {
                    if (companyInputs[i].checked) return companyInputs[i];
                }
                return null;
            }

            function refresh(keepBranch) {
                var input = selectedCompany();
                branchSelect.innerHTML = '';

                if (!input) {
                    branchSelect.appendChild(new Option('Choose an organisation first', ''));
                    formTitle.textContent = 'Create your officer account';
                    return;
                }

                formTitle.textContent = 'Register with ' + input.dataset.companyName;

                var companyId = parseInt(input.value, 10);
                branchSelect.appendChild(new Option('Select your station', ''));

                branches
                    .filter(function (b) { return b.CompanyId === companyId; })
                    .forEach(function (b) {
                        var option = new Option(b.Name, b.ReferenceNumber);
                        if (keepBranch && b.ReferenceNumber === chosenBranch) {
                            option.selected = true;
                        }
                        branchSelect.appendChild(option);
                    });
            }

            companyInputs.forEach(function (input) {
                input.addEventListener('change', function () { refresh(false); });
            });

            // Keep the posted-back choice when validation redisplays the form.
            refresh(true);
        })();
    </script>
}
